#!/bin/bash
# nru-cam-port - choose which AC camera is on which GMSL port of an NRU-230V.
#
# Usage (as root):
#   nru-cam-port set <port>=<camera> [...]   save the map, reload the driver, show the result
#   nru-cam-port load                        reload the driver with the saved map (for example after boot)
#   nru-cam-port show                        show the map, the video device and the signal of each port
#   nru-cam-port list                        show the camera names
# Example:
#   nru-cam-port set 0=isx031 1=isx031 2=isx031 3=isx031 4=imx490 5=imx490 6=imx390 7=imx390
#
# Run the stock init script first (cd ~/Desktop/Camera && sudo ./init_8xIMXCam.sh).
# A port that is not given keeps its saved camera (default: the built-in map of nv_nru_mix230.ko).
# Use /dev/nru-portN in your pipeline. /dev/nru-portN is always Port#N, also after a reload.
set -u
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
KO="${KO:-$HERE/nv_nru_mix230.ko}"
MOD=nv_nru_mix230
CONF="${CONF:-/etc/nru-cam-port.conf}"
BUS=2

# camera name -> frame size (UYVY, 30 fps). All use the stock init_8xIMXCam.sh.
declare -A SIZE=([isx031]=1920x1536 [imx490]=2880x1860 [imx390]=1920x1080 [isx021]=1920x1280)
DEFAULT=(isx031 isx031 isx031 isx031 imx490 imx490 imx390 imx390)   # same as the built-in map

# Port -> i2c address of the camera node, MAX9296 address and video pipe status register
ADDR=(0x76 0x74 0x77 0x75 0x72 0x70 0x73 0x71)
DES=(0x6c 0x68 0x6c 0x68 0x4a 0x48 0x4a 0x48)
PIPE=(0x08 0x08 0x1A 0x1A 0x08 0x08 0x1A 0x1A)
# Two ports share one 4-lane CSI input: 0+2, 1+3, 4+6, 5+7
PAIR=(2 3 0 1 6 7 4 5)
PAIR_GBPS=6.0   # 4 lanes x 1.5 Gbps (stock PHY setting, estimate)

die() { echo "ERROR: $*" >&2; exit 1; }
need_root() { [ "$(id -u)" -eq 0 ] || die "run as root (sudo)"; }

check_board() {   # NRU-230V: 4 MAX9296 (ID 0x94) on i2c bus 2. The model string cannot tell it from a product without GMSL.
    local d
    for d in "${DES[@]:0:2}" "${DES[@]:4:2}"; do
        [ "$(i2ctransfer -f -y $BUS w2@$d 0x00 0x0D r1 2>/dev/null)" = "0x94" ] || die "no GMSL deserializer at $d on i2c bus $BUS. This tool is for NRU-230V."
    done
}

read_map() {   # CAM[0..7] from $CONF, else default
    CAM=("${DEFAULT[@]}")
    [ -r "$CONF" ] || return 0
    local line p c
    while read -r line; do
        case "$line" in ''|\#*) continue ;; esac
        p="${line%%=*}"; c="${line#*=}"
        [[ "$p" =~ ^[0-7]$ ]] && [ -n "${SIZE[$c]:-}" ] && CAM[$p]="$c"
    done < "$CONF"
}

write_map() {
    local p
    { echo "# nru-cam-port: Port#N=camera (written $(date '+%F %T'))"
      for p in 0 1 2 3 4 5 6 7; do echo "$p=${CAM[$p]}"; done; } > "$CONF.tmp" && mv "$CONF.tmp" "$CONF"
}

gbps() { local w="${1%x*}" h="${1#*x}"; awk -v w="$w" -v h="$h" 'BEGIN{printf "%.2f", w*h*16*30/1e9}'; }

check_bandwidth() {
    local p q s
    for p in 0 1 4 5; do
        q="${PAIR[$p]}"
        s="$(awk -v a="$(gbps "${SIZE[${CAM[$p]}]}")" -v b="$(gbps "${SIZE[${CAM[$q]}]}")" 'BEGIN{printf "%.2f", a+b}')"
        if awk -v s="$s" -v m="$PAIR_GBPS" 'BEGIN{exit !(s>m)}'; then
            echo "WARNING: Port#$p + Port#$q = $s Gbps, more than $PAIR_GBPS Gbps (shared CSI input)" >&2
        fi
    done
}

locked() {   # 1 if the video pipe of port $1 has VID_LOCK
    local v; v="$(i2ctransfer -f -y $BUS w2@${DES[$1]} 0x01 ${PIPE[$1]} r1 2>/dev/null)" || { echo 0; return; }
    echo $(( (v & 0x40) != 0 ))
}

make_nodes() {   # /dev/nru-portN -> char device of the camera node of Port#N
    local p dev n devnum
    rm -f /dev/nru-port[0-7]
    for p in 0 1 2 3 4 5 6 7; do
        dev="$BUS-$(printf '%04x' "${ADDR[$p]}")"
        for n in /sys/class/video4linux/video*; do
            [ "$(cat "$n/name" 2>/dev/null)" = "vi-output, nru2mp $dev" ] || continue
            devnum="$(cat "$n/dev")"
            mknod -m 660 "/dev/nru-port$p" c "${devnum%:*}" "${devnum#*:}" && chgrp video "/dev/nru-port$p"
        done
    done
}

load() {
    [ -f "$KO" ] || die "$KO: file not found"
    local m arg="" p
    for p in 0 1 2 3 4 5 6 7; do arg="$arg${arg:+,}${SIZE[${CAM[$p]}]}"; done
    for m in $(lsmod | awk '/^nv_nru/{print $1}'); do
        rmmod "$m" 2>/dev/null || die "cannot remove $m. Close all video streams first."
    done
    insmod "$KO" port_size="$arg" || die "insmod $KO failed (see dmesg)"
    sleep 2
    make_nodes
    local live=""
    for p in 0 1 2 3 4 5 6 7; do [ "$(locked "$p")" = 1 ] && live="$live $p"; done
    echo "${live# }" > /run/nru-cam-port.live   # read by nru-cam-show (runs as the desktop user)
}

show() {
    local p have size dev sig
    have="$(cat /sys/module/$MOD/parameters/port_size 2>/dev/null)"
    [ -n "$have" ] || echo "NOTE: $MOD is not loaded. Run: $0 load"
    printf '%-6s %-8s %-10s %-9s %-15s %s\n' PORT CAMERA SIZE DEVICE NODE SIGNAL
    for p in 0 1 2 3 4 5 6 7; do
        dev="$BUS-$(printf '%04x' "${ADDR[$p]}")"
        size="$(echo "$have" | cut -d, -f$((p+1)))"
        [ -e "/dev/nru-port$p" ] && node="/dev/nru-port$p" || node="-"
        [ "$(locked "$p")" = 1 ] && sig="yes" || sig="NO (do not open)"
        printf '%-6s %-8s %-10s %-9s %-15s %s\n' "#$p" "${CAM[$p]}" "${size:--}" "$dev" "$node" "$sig"
    done
}

cmd="${1:-show}"; shift || true
case "$cmd" in
    list)
        for c in isx031 imx490 imx390 isx021; do echo "$c  ${SIZE[$c]}  $(gbps "${SIZE[$c]}") Gbps"; done
        echo "(AC-AR0233 needs init_8xAR0233.sh, so it cannot be mixed with these cameras)" ;;
    set)
        need_root; check_board; read_map
        [ $# -gt 0 ] || die "give <port>=<camera>, for example 6=imx390. Run: $0 list"
        for a in "$@"; do
            p="${a%%=*}"; c="$(echo "${a#*=}" | tr 'A-Z' 'a-z')"; c="${c#ac-}"
            [[ "$p" =~ ^[0-7]$ ]] || die "$a: port must be 0-7"
            [ "$c" = ar0233 ] && die "$a: AC-AR0233 needs a different init script and cannot be mixed"
            [ -n "${SIZE[$c]:-}" ] || die "$a: unknown camera '$c'. Run: $0 list"
            CAM[$p]="$c"
        done
        check_bandwidth; write_map; load; show ;;
    load)
        need_root; check_board; read_map; check_bandwidth; load; show ;;
    show)
        need_root; check_board; read_map; show ;;
    *) sed -n '2,16p' "$0"; exit 2 ;;
esac
