<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ads_messages</name>
  <version>0.0.0</version>

  <!-- The message definitions in msg/ are HATCI's, not ours. They were
       reproduced verbatim from the schemas embedded in HATCI's own October
       2026 bag files, which is the only reason this package can exist. It
       carries no logic of any kind.

       The package name is NOT a choice. rosbag2 resolves the type name
       recorded in the bag, "ads_messages/msg/CANMsg", so a package under any
       other name cannot deserialize those bags.

       REPLAY ONLY. See README.md for why this must never be the package that
       is active when reading a live vehicle CAN topic. -->
  <description>
    Reconstructed ads_messages type definitions, for replaying HATCI's recorded
    bags offline. Not for live vehicle use: replace with HATCI's own package.
  </description>

  <maintainer email="noreply@example.com">HATCI-MDP contributors</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
